{
  "name": "theta-meishi-hatch",
  "productName": "Theta Meishi Hatch",
  "version": "0.2.1",
  "description": "Theta Meishi Hatch for Windows / Mac — reads and writes the Theta Vault directly; also serves DeskHatch drawers.",
  "main": "main.js",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "sync-ui": "node scripts/sync-ui.js",
    "start": "npm run sync-ui && electron .",
    "test": "npm run sync-ui && node --test test/*.test.js",
    "dist:win": "npm run sync-ui && electron-builder --win zip --publish never",
    "dist:mac": "npm run sync-ui && electron-builder --mac --publish never",
    "test:e2e": "node test/e2e/ui.e2e.cjs && node test/e2e/electron-smoke.cjs"
  },
  "dependencies": {
    "pdfjs-dist": "4.10.38",
    "yaml": "2.6.1"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "jp.yaegaki.theta.meishi",
    "productName": "Theta Meishi Hatch",
    "files": [
      "main.js",
      "lib/**",
      "ui/**",
      "assets/**",
      "package.json",
      "!node_modules/@napi-rs/**",
      "!node_modules/pdfjs-dist/{build,web,image_decoders,types}/**",
      "!node_modules/pdfjs-dist/legacy/{web,image_decoders}/**",
      "!**/*.map"
    ],
    "win": {
      "target": [
        "zip"
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null
    },
    "directories": {
      "output": "dist"
    },
    "icon": "assets/icon.png",
    "publish": null
  }
}
